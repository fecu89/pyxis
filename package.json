{
  "name": "pyx-course",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.9.0",
    "yarn": ">=1.22"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "NEXT_DIST_DIR=${NEXT_DIST_DIR:-.next-prod} next build",
    "deploy": "bash scripts/deploy.sh",
    "db:backfill-nicknames": "tsx scripts/backfill-nickname-lookups.ts",
    "db:backfill-pii": "tsx scripts/backfill-user-pii.ts",
    "db:backfill-profile-images": "NODE_OPTIONS=--conditions=react-server tsx scripts/backfill-profile-images.ts",
    "db:backfill-quiz-images": "NODE_OPTIONS=--conditions=react-server tsx scripts/backfill-quiz-images.ts",
    "db:create-admin": "NODE_OPTIONS=--conditions=react-server tsx scripts/create-super-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate-login-ids": "tsx scripts/migrate-credential-login-ids.ts",
    "db:rotate-pii": "tsx scripts/rotate-user-pii.ts",
    "db:seed": "prisma db seed",
    "dev": "node --max-old-space-size=3072 --import tsx server.ts",
    "lint": "eslint",
    "postinstall": "node scripts/sync-viewer-assets.mjs",
    "prebuild": "node scripts/sync-viewer-assets.mjs",
    "predev": "node scripts/sync-viewer-assets.mjs",
    "start": "NODE_ENV=production NEXT_DIST_DIR=${NEXT_DIST_DIR:-.next-prod} tsx server.ts",
    "verify:deploy": "node --test scripts/verify-deploy.mjs",
    "verify:admin-bulk": "node scripts/verify-admin-bulk-browser.mjs",
    "verify:signup-consent": "node --test scripts/verify-signup-consent.mjs && node scripts/verify-signup-consent-browser.mjs",
    "verify:learning": "node --test scripts/verify-course-learning.mjs scripts/verify-course-live.mjs scripts/verify-course-join.mjs scripts/verify-learning-routes.mjs scripts/verify-learning-ui.mjs scripts/verify-learning-filter.mjs && node scripts/verify-learning-browser.mjs && node scripts/verify-quiz-entry-browser.mjs",
    "verify:access": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-board-access-policy.ts",
    "verify:api-boundaries": "tsx scripts/verify-api-boundaries.ts",
    "verify:auth": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-credential-auth.ts",
    "verify:auth-password-ui": "node scripts/verify-auth-password-ui.mjs",
    "verify:profile-image": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-profile-image.ts && NODE_OPTIONS=--conditions=react-server tsx scripts/verify-profile-image-backfill.ts && node scripts/verify-profile-image-browser.mjs",
    "verify:approvals": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-approval-workflows.ts",
    "verify:board-create-options": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-board-create-options.ts",
    "verify:board-password-security": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-board-password-security.ts",
    "verify:guest": "bash scripts/verify-guest-posting.sh",
    "verify:link-guest": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-link-guest-policy.ts && NODE_OPTIONS=--conditions=react-server tsx scripts/verify-link-guest-api.ts",
    "verify:http": "tsx scripts/verify-admin-http.ts",
    "verify:invite-redemption": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-invite-redemption.ts",
    "verify:link-preview": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-link-preview.ts",
    "verify:multipart-limits": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-multipart-limits.ts",
    "verify:export-limits": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-export-rate-limits.ts",
    "verify:forms-schema": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-forms-schema.ts",
    "verify:forms-save": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-forms-save.ts",
    "verify:forms-submit": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-forms-submit.ts",
    "verify:forms-responses": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-forms-responses.ts",
    "verify:forms-followups": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-forms-followups.ts",
    "verify:form-editor-merge": "tsx scripts/verify-form-editor-merge.ts",
    "verify:form-editor-autosave": "node scripts/verify-form-editor-autosave.mjs",
    "verify:form-save-errors": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-form-save-errors.ts",
    "verify:field-type-picker": "node scripts/verify-field-type-picker.mjs",
    "verify:form-card-access": "tsx scripts/verify-form-card-access.ts",
    "verify:notifications": "tsx scripts/verify-notification-visibility.ts",
    "verify:access-request-notifications": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-access-request-notifications.ts",
    "verify:pagination": "tsx scripts/verify-post-pagination.ts",
    "verify:pad-realtime": "tsx scripts/verify-pad-realtime-merge.ts",
    "verify:pad-nav-layout": "node scripts/verify-pad-nav-layout.mjs",
    "verify:pad-settings-members": "node scripts/verify-pad-settings-members.mjs",
    "verify:post-card-menu": "node scripts/verify-post-card-menu.mjs",
    "verify:performance": "tsx scripts/verify-performance-boundaries.ts",
    "verify:upload-policy": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-upload-policy.ts",
    "verify:quiz-assign": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-quiz-assign-candidates.ts",
    "verify:quiz-images": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-quiz-images.ts",
    "verify:quiz-live": "tsx scripts/verify-quiz-live.ts",
    "verify:quiz-save": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-quiz-save.ts",
    "quiz-images:prune": "NODE_OPTIONS=--conditions=react-server tsx scripts/prune-quiz-images.ts",
    "pad-trash:prune": "NODE_OPTIONS=--conditions=react-server tsx scripts/prune-pad-trash.ts",
    "verify:post": "tsx scripts/verify-post-participation.ts",
    "verify:post-content": "tsx scripts/verify-post-content-blocks.ts",
    "verify:public-quiz-limits": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-public-quiz-limits.ts",
    "verify:roster": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-student-roster.ts",
    "verify:roster-union": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-course-roster.ts",
    "verify:routes": "tsx scripts/verify-routes.ts",
    "verify:security": "tsx scripts/verify-security-data.ts",
    "verify:socket-payloads": "tsx scripts/verify-socket-payloads.ts",
    "verify:short-links": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-short-links.ts",
    "verify:seo": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-seo-metadata.ts",
    "verify:student-reports": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-student-reports.ts",
    "verify:succession": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-board-succession.ts",
    "viewer:build-converter": "podman build -t localhost/pyxis-document-converter:latest deploy/document-converter",
    "viewer:prune-cache": "NODE_OPTIONS=--conditions=react-server tsx scripts/prune-document-preview-cache.ts",
    "viewer:sync": "node scripts/sync-viewer-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@milkdown/core": "7.22.1",
    "@milkdown/plugin-history": "7.22.1",
    "@milkdown/plugin-listener": "7.22.1",
    "@milkdown/preset-commonmark": "7.22.1",
    "@milkdown/prose": "7.22.1",
    "@milkdown/utils": "7.22.1",
    "@next/env": "16.3.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@rhwp/core": "0.8.2",
    "archiver": "^8.0.0",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "cookie": "^0.7.2",
    "exceljs": "^4.4.0",
    "file-type": "^22.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "pdfjs-dist": "6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "signature_pad": "^5.1.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/busboy": "^1.5.4",
    "@types/cookie": "^0.6.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "find-my-way": "9.9.0",
    "valibot": "1.5.0",
    "prisma/mysql2": "3.24.4",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "postcss": "8.5.28",
    "find-my-way": "9.9.0",
    "valibot": "1.5.0",
    "uuid": "^11.1.1",
    "prisma": {
      "mysql2": "3.24.4"
    }
  },
  "packageManager": "yarn@1.22.22"
}
