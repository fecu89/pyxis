# 공개용 설정 예시입니다. 실제 비밀값을 넣거나 실제 .env 파일을 커밋하지 마세요.
# 이 파일은 자동 로드되지 않습니다. 필요한 항목을 .env.local 또는 환경별 파일로 옮깁니다.
# 개발·운영의 우선순위: 프로세스 환경변수 > .env.<환경>.local > .env.local > .env.<환경> > .env.
# NODE_ENV는 실행 명령이 정합니다. NEXT_PUBLIC_*에는 공개 가능한 값만 넣고 변경 후 재빌드하세요.
# 단위 MB는 이 프로젝트에서 1024 * 1024바이트로 계산합니다.

# PostgreSQL 연결 문자열. 실제 자격증명은 비공개 환경 파일/배포 환경변수로만 관리합니다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# 화면·메타데이터에 표시할 제품명입니다. 비우면 pyxis를 사용합니다.
NEXT_PUBLIC_APP_NAME=pyxis
# 커스텀 서버(server.ts)가 듣는 포트입니다. Next 요청 처리와 Socket.IO가 같은 포트를 씁니다.
PORT=3001
# BIND_HOST가 비어 있으면 loopback 전용 바인딩을 보장하지 않습니다.
# 같은 서버의 Cloudflare Tunnel만 쓸 때는 127.0.0.1로 두고,
# CLOUDFLARE_TUNNEL_ONLY와 TRUST_CLOUDFLARE_IP_HEADER를 함께 true로 설정하세요.
BIND_HOST=
CLOUDFLARE_TUNNEL_ONLY=false
# 로그인/콜백의 외부 기준 URL입니다. 운영에서는 실제 HTTPS 주소를 사용합니다.
NEXTAUTH_URL=http://localhost:3001
# canonical·OG·공유 이미지 기준 URL. 환경별 .env에 설정하며 생략 시 인증 URL 등을 사용합니다.
# NEXT_PUBLIC_URL=http://localhost:3001
# 쓰기 요청에서 허용할 Origin을 쉼표로 구분합니다. 프로토콜·호스트·포트가 일치해야 합니다.
# localhost와 127.0.0.1은 별개이며, 임의의 외부 Origin을 추가하지 마세요.
APP_ORIGINS=http://localhost:3001
# 로그인 세션·소켓 인증이 공유하는 비밀키입니다. 개발/운영에 같은 값을 무심코 재사용하지 마세요.
AUTH_SECRET=replace-with-a-long-random-secret
# 카카오 개발자 앱의 REST API 키와 Client Secret. 콜백 주소도 해당 앱에 등록합니다.
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
# 새 데이터의 암호화 키 ID입니다. v1은 아래 PII_ENCRYPTION_KEY_V1을 참조합니다.
PII_ACTIVE_KEY_ID=v1
# 개인정보와 패드 비밀번호 암호화 키(base64 32바이트). 교체 시 이전 키를 보존한 채 재암호화합니다.
# 키를 잃으면 기존 암호문을 복구할 수 없으므로 DB와 분리해 안전하게 백업하세요.
PII_ENCRYPTION_KEY_V1=replace-with-base64-encoded-32-byte-key
# 검색용 HMAC 키는 암호화 키와 다른 base64 32바이트 값입니다. 교체 시 조회값 마이그레이션이 필요합니다.
PII_LOOKUP_KEY=replace-with-a-different-base64-encoded-32-byte-key
# 카카오 신규 가입 시에만 이 이메일의 계정에 SUPER_ADMIN을 부여합니다. 기존 계정은 승격하지 않습니다.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
# 첨부·프로필·설문 파일·문서 미리보기의 영구 저장 루트. 미설정 시 ./data/uploads입니다.
# 아래 ./uploads 예시를 쓰면 .gitignore에도 /uploads/를 추가하세요. 운영 데이터는 Git에 넣지 않습니다.
# 경로 변경만으로 기존 파일이 이동하지 않습니다. 변경 전 데이터 이전/백업을 별도로 계획하세요.
UPLOAD_DIR=./uploads
# 일반 첨부 상한의 환경변수 fallback입니다(1~30MB). Admin > Settings의 DB 정책이 우선합니다.
# 우선순위: 저장된 DB 정책 > 이 환경변수 > 코드 기본값(30MB). DB 조회 실패 시에도 fallback을 씁니다.
# 이미지·손님·패드 배경·퀴즈 이미지의 개별 상한은 Admin에서 정하며 전체 상한을 넘지 못합니다.
# Next proxy 본문은 30MB + multipart 여유 5MB입니다. 여유분은 파일 허용 용량이 아닙니다.
MAX_UPLOAD_SIZE_MB=30

# sharp 이미지 변환의 동시 실행 수와, 슬롯이 찼을 때 기다릴 수 있는 요청 수입니다. 대기열이
# 가득 차면 새 업로드는 기다리지 않고 즉시 503으로 돌려보냅니다(대기 중인 요청마다 임시 파일이
# 디스크에 남기 때문에 무한정 쌓이게 두지 않습니다).
IMAGE_PROCESSING_CONCURRENCY=2
IMAGE_PROCESSING_MAX_QUEUE=32

# 퀴즈 하나의 이미지 총량 fallback(16~102400MB). Admin의 해당 DB 정책이 우선합니다.
MAX_QUIZ_IMAGE_STORAGE_MB=256
# 미참조 이미지는 업로드 후 24시간 동안 보존합니다. 아래는 정리 작업 실행 간격(시간)입니다.
QUIZ_IMAGE_SWEEP_INTERVAL_HOURS=6
# 0이면 삭제 퀴즈 purge를 끕니다. 기본은 90일이며, 응시 세션이 있는 퀴즈는 항상 보존합니다.
QUIZ_DELETED_PURGE_DAYS=90

# 프로세스 전체 SSE 동시 연결 상한(양의 정수)입니다. 퀴즈 Socket.IO 연결 상한과는 별개입니다.
# 패드 SSE는 보드당 로그인 사용자 6개, 익명 IP 버킷 240개로 별도 제한합니다.
# 신뢰할 수 있는 IP가 없으면 해당 보드의 익명 방문자가 하나의 버킷을 공유합니다.
MAX_SSE_CONNECTIONS=2000

# Vercel은 자동 감지합니다. 자체 Cloudflare/리버스 프록시 배포에서 원본 서버 접근을 해당
# 프록시로 제한한 경우에만 둘 중 맞는 값을 true로 바꾸세요. 직접 노출 서버에서는 켜지 마세요.
# 참고: 자체 운영 배포에서 이 값이 모두 false면 익명 요청의 IP를 신뢰할 수 없어, IP 기반 요청량 제한이
# "공격자 한 명이 전체 익명 사용자를 함께 막는" 자기 DoS가 되므로 자동으로 비활성화됩니다.
# 그 배포에서는 WAF·프록시 계층에서 공개 경로 제한을 함께 두세요.
TRUST_CLOUDFLARE_IP_HEADER=false
TRUST_X_FORWARDED_FOR=false

# 관리 콘솔의 민감 작업 재인증 시간과 공개 퀴즈 요청·소켓 상한은 관리 콘솔의 정책 탭에서
# 설정하며 SystemSetting이 정본입니다.

# 오피스 문서(pptx·docx·xlsx)는 기본적으로 rootless Podman의 일회성 컨테이너에서 PDF로
# 변환합니다. `yarn viewer:build-converter`로 이미지를 먼저 만드세요. 이미지가 없으면 기능만
# 조용히 꺼지고 내려받기 카드는 계속 동작합니다.
DOCUMENT_CONVERTER_MODE=podman
# 변환을 끄려면 DOCUMENT_CONVERTER_MODE=disabled. 업로드·원본 다운로드는 별개입니다.
DOCUMENT_CONVERTER_IMAGE=localhost/pyxis-document-converter:latest
# 동시 변환 1~8개. 미설정 시 CPU 수에 따라 1~2개. 전체 대기열은 1~512개입니다.
DOCUMENT_CONVERT_CONCURRENCY=2
DOCUMENT_CONVERT_MAX_QUEUE=64
# 백그라운드 선변환 대기열(0~64개), 변환 PDF 출력 상한(16~512MB)입니다.
DOCUMENT_CONVERT_MAX_WARMUP_QUEUE=8
DOCUMENT_CONVERT_MAX_OUTPUT_MB=256

# 격리 없는 호스트 실행은 개발 호환용입니다. 반드시 명시적으로 native를 선택해야만 켜집니다.
#DOCUMENT_CONVERTER_MODE=native
#SOFFICE_PATH=/usr/bin/soffice

# 파생 PDF 캐시는 `yarn viewer:prune-cache`로 정리합니다. 매일 실행하려면 별도 스케줄 등록이 필요합니다.
# 상한을 넘으면 오래 사용하지 않은
# 파일부터 목표 용량까지 줄이고, 최대 보관일을 넘긴 파생 파일은 용량과 무관하게 지웁니다.
DOCUMENT_PREVIEW_CACHE_MAX_MB=10240
DOCUMENT_PREVIEW_CACHE_TARGET_MB=8192
DOCUMENT_PREVIEW_CACHE_MAX_AGE_DAYS=90

# 운영 배포는 yarn deploy가 NEXT_DIST_DIR로 .next-a/.next-b를 전환합니다. 환경 파일에 슬롯을 고정하지 마세요.
# UPSTAGE_API_KEY는 현재 애플리케이션 소스에서 사용하지 않으며, 기본 실행에 필요하지 않습니다.
# Pad 게시물 이미지 비동기 최적화. DB 마이그레이션 + 새 앱 적용 후 true로 활성화.
# false는 기존 동기 변환. 큐는 DB에 남으며 다시 true로 켜면 처리를 재개합니다.
PAD_BACKGROUND_IMAGES_ENABLED=false
