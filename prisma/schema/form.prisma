// 설문 도메인. 구글 설문지에 해당합니다. 회원·학교·권한은 identity.prisma를 공유합니다.
//
// 퀴즈와 모양이 비슷하지만 세션·PIN·채점·실시간 진행이 없습니다. 링크 하나가 기간 동안 열려
// 있는 흐름이라 QuizSession에 해당하는 중간 계층이 없고, Form이 직접 Activity를 가리킵니다.
//
// 퀴즈의 참여형 문항(SURVEY·LIKERT)으로는 이걸 대신할 수 없습니다. 그쪽은 교사가 세션을 열고
// 학생이 PIN으로 들어와 실시간으로 진행하는 동안에만 동작하는데, 학부모 동의서나 수요 조사처럼
// 링크를 뿌려 두고 며칠에 걸쳐 받는 요구는 그 구조로 표현되지 않습니다.

enum FormStatus {
  DRAFT // 링크가 죽어 있습니다
  OPEN // 응답을 받습니다
  CLOSED // 안내만 띄웁니다
}

enum FormFieldType {
  SHORT_TEXT // 단답형
  LONG_TEXT // 장문형
  MULTIPLE_CHOICE // 객관식(라디오)
  CHECKBOXES // 체크박스
  DROPDOWN // 드롭다운
  LINEAR_SCALE // 선형배율(리커트)
  RATING // 등급
  MULTIPLE_CHOICE_GRID // 객관식 그리드
  CHECKBOX_GRID // 체크박스 그리드
  DATE
  TIME
  FILE_UPLOAD // 로그인 사용자만 파일을 올릴 수 있습니다
  SIGNATURE // 서명. 구글 설문지에는 없는 확장입니다
  SECTION_HEADER // 입력을 받지 않는 설명 블록
}

enum RatingIcon {
  STAR
  HEART
  THUMB
}

enum FormPermission {
  VIEWER
  EDITOR
}

enum FormResponseStatus {
  IN_PROGRESS
  SUBMITTED
}

model Form {
  id            String     @id @default(cuid())
  ownerId       String
  subjectId     String?
  // 통합 리포트(/report)와 대시보드가 읽는 공통 활동 레코드입니다. activity.prisma 참고.
  // QuizSession·Board와 같은 이유로 **필수**입니다 — 빠뜨리면 그 설문은 /report에 아예 나타나지
  // 않는데 화면은 멀쩡히 뜨므로 눈으로는 발견되지 않습니다.
  activityId    String     @unique
  // 공개 응답 주소 /s/{slug}. Board.slug와 같은 역할입니다.
  slug          String     @unique
  title         String
  description   String?
  status        FormStatus @default(DRAFT)
  // false면 로그인 없이 응답할 수 있습니다. Quiz.requiresLogin과 달리 하위 세션으로 복사되지
  // 않고 이 값이 곧 최종 판정입니다(중간 계층이 없으므로).
  requiresLogin Boolean    @default(true)

  // 응답 정책
  allowMultipleResponses     Boolean   @default(false)
  allowEditAfterSubmit       Boolean   @default(false)
  shuffleFields              Boolean   @default(false)
  showProgressBar            Boolean   @default(true)
  confirmationMessage        String?
  // 직접 마감·기간 종료·정원 도달 뒤 공개 링크에 보여 줄 소유자 안내입니다.
  closedMessage              String?
  dailyResponseDigestEnabled Boolean   @default(true)
  responseDigestPendingCount Int       @default(0)
  responseDigestPendingSince DateTime?
  responseDigestLastSentAt   DateTime?

  // 기간·정원
  openAt        DateTime?
  closeAt       DateTime?
  maxResponses  Int?
  // 정원 판정용 비정규화 카운터입니다. 제출마다 count()를 돌면 응답이 쌓일수록 제출이 느려집니다.
  // 증가는 반드시 응답 생성과 같은 트랜잭션에서만 합니다.
  responseCount Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  // Quiz와 같은 뜻입니다. deletedAt은 "소유자가 버렸다"(목록에서 사라짐),
  // frozenAt은 "주인이 없다"(읽기는 되고 편집·발행만 막힘).
  frozenAt  DateTime?

  owner         User               @relation("FormOwner", fields: [ownerId], references: [id])
  subject       Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  activity      Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fields        FormField[]
  responses     FormResponse[]
  shares        FormShare[]
  visits        FormVisit[]
  notifications Notification[]
  uploadedFiles FormUploadedFile[]
  shortLinks    ShortLink[]

  @@index([ownerId, deletedAt])
  @@index([subjectId, deletedAt])
  // 마감 시각이 지난 OPEN 설문을 쓸어 담는 배치용입니다.
  @@index([status, closeAt])
}

// 설문 관리 화면의 최근 목록도 편집 시각이 아니라 실제로 마지막으로 연 시각을 사용합니다.
model FormVisit {
  formId        String
  userId        String
  lastVisitedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([formId, userId])
  @@index([userId, lastVisitedAt])
}

// 유형별 서브테이블이나 설정 JSON 블롭이 아니라 **유형별 nullable 열을 가진 넓은 테이블 하나**
// 입니다(Question과 같은 전략). 서브테이블로 나누면 유형을 바꿀 때 행을 옮겨야 해서 편집 중
// ID가 끊기고 응답의 참조도 함께 끊깁니다. JSON 블롭으로 두면 "선형배율 평균"이나 "필수인데
// 안 채운 응답" 같은 집계를 SQL로 쓸 수 없어 응답이 쌓이는 만큼 응용 코드 루프가 됩니다.
model FormField {
  id String @id @default(cuid())

  formId      String
  type        FormFieldType @default(SHORT_TEXT)
  title       String
  // 구글 설문지의 "설명" 토글에 해당합니다.
  description String?
  required    Boolean       @default(false)
  position    Int
  imageUrl    String?
  imageAlt    String?

  // 선택형 전용(객관식·체크박스·드롭다운, 그리고 그리드의 **열**)
  shuffleOptions Boolean @default(false)
  allowOther     Boolean @default(false) // "기타" 자유 입력칸

  // 그리드 전용. 행 라벨이 여기 있고 열은 options가 담습니다 — 열은 응답이 가리키는 대상이라
  // 안정된 ID가 필요하고(보기를 고쳐도 과거 응답이 살아야 함), 행은 라벨일 뿐이라 배열로
  // 충분합니다.
  gridRows                     String[] @default([])
  gridRequireOneResponsePerRow Boolean  @default(false)

  // LINEAR_SCALE 전용
  scaleMin      Int?
  scaleMax      Int?
  scaleMinLabel String?
  scaleMaxLabel String?

  // RATING 전용
  ratingMax  Int? // 3~10
  ratingIcon RatingIcon?

  // DATE / TIME 전용
  includeYear  Boolean @default(true)
  includeTime  Boolean @default(false)
  durationMode Boolean @default(false) // TIME을 시각이 아니라 기간으로 받습니다

  // 객관식/드롭다운 보기별 다음 섹션. 형태는 lib/forms/branching.ts가 정본입니다.
  branchRules Json?

  // FILE_UPLOAD 전용. 전체 서버 업로드 정책보다 더 좁게만 설정할 수 있습니다.
  fileMaxCount     Int      @default(1)
  fileMaxSizeMb    Int      @default(10)
  fileAllowedTypes String[] @default(["IMAGE", "PDF", "DOCUMENT"])

  // 구글 설문지의 "응답 확인". 형태의 정본은 lib/forms/validation.ts입니다.
  // 화면과 제출 API가 **같은 validateAnswer()** 를 부르므로 규칙이 두 곳으로 갈라지지 않습니다.
  validation Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form          Form               @relation(fields: [formId], references: [id], onDelete: Cascade)
  options       FormFieldOption[]
  answers       FormAnswer[]
  uploadedFiles FormUploadedFile[]

  @@index([formId, position])
}

// Choice에서 isCorrect만 뺀 모양입니다. 설문에는 정답이 없습니다.
model FormFieldOption {
  id       String @id @default(cuid())
  fieldId  String
  text     String
  position Int

  field FormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, position])
}

model FormResponse {
  id             String             @id @default(cuid())
  formId         String
  respondentId   String? // 로그인 응답자
  guestTokenHash String? // 익명 응답자 쿠키의 sha256. 원문 토큰은 저장하지 않습니다
  respondentName String? // 익명 설문에서 이름을 따로 물었을 때만
  status         FormResponseStatus @default(SUBMITTED)
  startedAt      DateTime           @default(now())
  submittedAt    DateTime?
  updatedAt      DateTime           @updatedAt

  // 1인 1응답을 **DB가** 막게 하는 열입니다.
  //
  // allowMultipleResponses가 false일 때만 respondentId(로그인) 또는 guestTokenHash(익명)를
  // 넣고, true면 null을 넣습니다. PostgreSQL은 유니크 인덱스에서 null을 서로 다른 값으로
  // 취급하므로 제약 하나로 두 정책이 다 표현됩니다.
  //
  // @@unique([formId, respondentId])로 하지 않은 이유 — 그러면 복수 응답 허용을 표현할 수
  // 없습니다. 응용 코드에서 검사하지 않는 이유 — "조회했더니 없어서 만들었다"는 두 요청이
  // 동시에 오면 둘 다 통과합니다. 설문 링크는 단톡방에 뿌려지므로 실제로 동시에 옵니다.
  dedupeKey String?

  form          Form               @relation(fields: [formId], references: [id], onDelete: Cascade)
  respondent    User?              @relation("FormRespondent", fields: [respondentId], references: [id], onDelete: SetNull)
  answers       FormAnswer[]
  uploadedFiles FormUploadedFile[]

  @@unique([formId, dedupeKey])
  @@index([formId, submittedAt])
  @@index([formId, guestTokenHash])
  @@index([respondentId, submittedAt])
}

model FormAnswer {
  id         String @id @default(cuid())
  responseId String
  fieldId    String

  // 응답 시점 스냅샷입니다. 설문은 OPEN 중에도 질문 유형·문구를 바꿀 수 있어서(save.ts 참고),
  // 라이브 FormField를 그대로 따라가면 과거 응답을 지금 정의로 잘못 해석하게 됩니다 — 예를 들어
  // LINEAR_SCALE이던 질문이 SHORT_TEXT로 바뀌면 저장된 numberValue를 숫자로 보여줘야 하는지
  // 텍스트로 보여줘야 하는지 판단이 서지 않습니다. 응답을 만들 때 그 순간의 유형·문구를 그대로
  // 복사해 둡니다.
  fieldType  FormFieldType
  fieldTitle String

  textValue String? // 단답·장문·"기타" 입력

  // Answer.selectedChoiceIds와 같이 FK가 아닌 평범한 배열입니다. 참조 무결성 대신 아래 텍스트
  // 스냅샷으로 과거 응답을 지킵니다 — 보기를 지웠을 때 응답이 통째로 사라지는 것보다
  // "무엇을 골랐었는지"가 남는 쪽이 낫습니다.
  selectedOptionIds   String[] @default([])
  selectedOptionTexts String[] @default([])

  numberValue Float? // 선형배율·등급
  dateValue   DateTime? // 날짜(+시간)
  timeValue   String? // "14:30" 또는 기간 "01:30"

  // 그리드 전용: [{ row, rowLabel, optionIds, optionTexts }]. 행마다 답이 하나씩 생기므로 열로
  // 펼 수 없고, 그리드 전용 테이블을 따로 두면 다른 유형과의 대칭이 깨집니다. `rowLabel`은
  // 응답 시점 행 이름 스냅샷입니다 — `row`(인덱스)만 저장하면 OPEN 중 행을 지우거나 순서를
  // 바꿨을 때 과거 응답이 가리키는 행이 달라집니다. 형태의 정본은 lib/forms/field-types.ts입니다.
  gridValue Json?

  // 서명 전용: 0~1로 정규화한 획 좌표 + 선택적 압력·상대 시간. 형태의 정본은
  // lib/forms/signature.ts이며 기존 {x,y} 좌표도 계속 읽습니다.
  //
  // 래스터(webp 파일)로 두지 않은 이유 — 응답마다 파일이 생기면 저장소 한도·미참조 파일 정리
  // 스위퍼·열람 권한 검사가 전부 새로 필요합니다(퀴즈 이미지에 그 셋을 붙인 코드가 500줄이
  // 넘습니다). 벡터는 확대해도 깨지지 않아 인쇄에도 유리하고, Question.pinAreas가 이미 같은
  // 방식으로 좌표를 Json에 담고 있습니다.
  signatureStrokes Json?

  answeredAt DateTime @default(now())

  response FormResponse       @relation(fields: [responseId], references: [id], onDelete: Cascade)
  // Restrict입니다(Answer → Question과 같은 정책). 응답이 달린 질문을 지우는 건 데이터 손실이라
  // 저장 API가 명시적 확인 없이는 거부하게 만듭니다. 대신 설문을 통째로 지울 때는 답변을 먼저
  // 지워야 합니다 — 순서는 lib/forms/overview.md에 적어 두었습니다.
  field    FormField          @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  files    FormUploadedFile[]

  @@unique([responseId, fieldId])
  @@index([fieldId])
}

// 파일은 업로드 직후에는 answerId가 비어 있는 임시 상태이고, 제출 트랜잭션에서 본인 답변에
// 귀속됩니다. 게시물 Attachment는 postId가 필수이므로 저장/검증 코드만 공유하고 모델은 나눕니다.
model FormUploadedFile {
  id            String         @id @default(cuid())
  formId        String
  fieldId       String
  responseId    String?
  answerId      String?
  uploaderId    String
  type          AttachmentType
  originalName  String
  storedName    String         @unique
  storagePath   String
  thumbnailPath String?
  mimeType      String
  fileSize      Int
  width         Int?
  height        Int?
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  form     Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  field    FormField     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  response FormResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  answer   FormAnswer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  uploader User          @relation("FormFileUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([formId, fieldId, uploaderId, answerId])
  @@index([responseId])
  @@index([createdAt, answerId])
  @@index([deletedAt])
}

// QuizShare 복사본입니다. UI는 나중에 붙이지만 모델은 지금 넣습니다 — 나중에 넣으면
// 마이그레이션이 한 번 더 필요합니다.
model FormShare {
  formId      String
  userId      String
  permission  FormPermission
  grantedById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  form      Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user      User @relation("FormShareUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("FormShareGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([formId, userId])
  @@index([userId, permission])
}
